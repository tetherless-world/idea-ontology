    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#featureOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "B belongs to A, B is a feature of  A, B is under A domain. \n\nE.g.  prior knowledge of the model  genre-specific regularities of discourse structure English text in science domain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
