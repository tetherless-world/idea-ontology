}, {
  "@id" : "http://xmlns.com/foaf/0.1/Person",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A Person."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "(foaf) Person"
  } ]
}, {
  "@id" : "https://orcid.org/0000-0002-9313-0925",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/elements/1.1/abstract" : [ {
    "@value" : "The SUDO Ontology is an ontology for representing ideas, issues, arguments, and approaches in scientific research and scholarly communication."
  } ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "Nipun D. Pathirage"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@id" : "https://tetherless-world.github.io/sudo-ontology/ontology/idea_graph_figure.svg"
  }, {
    "@value" : "Scientific literature communicates knowledge not only through data and results but also through structured scholarly discourse, including motivations, problems, proposed ideas, supporting evidence, and claims. These abstract components are distributed across documents and connected through citations, making them difficult to extract and represent automatically. Existing scholarly knowledge graphs largely focus on metadata or citation networks, offering limited support for modeling scientific intent and argumentation.\n\nThe SUDO Graph addresses this limitation by introducing an ontology-centered framework that captures both concrete document structure and abstract scholarly discourse in a unified knowledge graph. The framework integrates layout-aware document parsing, ontology-guided extraction with large language models, and structured RDF instantiation. In addition, it models provenance information for all knowledge graph construction operations and adopts the PAV ontology to manage versioning and lineage of extracted instances. This design enables interpretable, evolvable, and semantically grounded scholarly knowledge graphs suitable for advanced querying, reasoning, and machine-assisted knowledge discovery."
  } ],
  "http://purl.org/dc/elements/1.1/license" : [ {
    "@type" : "xsd:anyURI",
    "@value" : "https://opensource.org/licenses/MIT"
  } ],
  "http://purl.org/dc/elements/1.1/modified" : [ {
    "@value" : "2025-12-29"
  } ],
  "http://purl.org/dc/elements/1.1/publisher" : [ {
    "@value" : "Tetherless World Constellation | Rensselaer Polytechnic Institute"
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@value" : "SUDO Ontology"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0000-0002-9313-0925"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "\n        https://w3id.org/twc/sudo/ontology#\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The Idea Graph is a framework for constructing ontology-driven scholarly knowledge graphs from scientific literature. It models scientific publications across three interconnected layers: document structure, extracted information, and abstract scholarly discourse such as research problems, ideas, evidence, and claims. The framework employs a discourse-aware ontology inspired by argumentation theory to align textual grounding, rhetorical intent, and citation attribution. An end-to-end pipeline transforms scientific PDFs into RDF graphs using layout-preserving parsing and ontology-guided large language model extraction. To ensure transparency and reproducibility, the system explicitly represents knowledge graph construction provenance and integrates the PAV ontology for instance-level versioning and lineage tracking. The resulting graphs support semantic querying, retrieval-augmented generation, and interactive visualization of discourse structures and citation roles."
  } ],
  "http://www.w3.org/2002/07/owl#backwardCompatibleWith" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology/releases/3.2.0"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://purl.org/spar/amo"
  }, {
    "@id" : "http://www.w3.org/ns/prov-o-20130430"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology/releases/3.2.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology/releases/3.5.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "3.4.0"
  } ],
  "http://www.w3.org/2004/02/skos/core#changeNote" : [ {
    "@value" : "Formatting and URI update of SUDO Ontology version 3.2.0."
  } ],
  "https://www.omg.org/spec/Commons/AnnotationVocabulary/copyright" : [ {
    "@value" : "Copyright (c) 2026 TWC"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Approach",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An Argument Proposition that presents, applies, or operationalizes a method, system, framework, dataset construction process, experimental setup, or other scholarly means used to address an Issue or realize an Idea. Approaches capture how a publication proposes to act on, investigate, or solve a research problem."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "approach"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/spar/amo/Argument"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Argument",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Argument"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Artifact",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A source-grounded, paper-local mention of a scholarly object, method, dataset, metric, task, term, or other noun-phrase referent. Artifacts preserve the original textual expression of concepts within a publication and may be aligned to canonical Concepts across papers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "artifact"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Concept"
  }, {
    "@id" : "_:genid25"
  }, {
    "@id" : "_:genid26"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/twc/sudo/ontology#Material"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Method"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Metric"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Task"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Term"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Cause",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A situation that, by means other than motivating a violational or non-violational action caused the situation presented in the artifact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "cause"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Descriptor"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Circumstance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The proposition providing the situation presents the framework for interpreting the artifact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "circumstance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Descriptor"
  }, {
    "@id" : "_:genid32"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Concept",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A canonical scholarly concept that provides a cross-publication identity for recurring paper-local Artifact mentions. Concepts abstract over source-specific phrasings while preserving links to the Artifacts through which they are expressed in individual publications"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "concept"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Proposition"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Condition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A realization of the situation presented in the proposition enables the realization of the situation presented in the artifact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Descriptor"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Descriptor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A Proposition that contextualizes, qualifies, characterizes, or elaborates an Artifact or another Proposition rather than advancing the publication's main research argument. Descriptors preserve local explanatory, evaluative, definitional, and conditional details that give scholarly concepts and statements their paper-specific meaning."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "descriptor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Proposition"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/twc/sudo/ontology#Cause"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Circumstance"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Condition"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Elaboration"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Evaluation"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Interpretation"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Purpose"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Restatement"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Result"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Solutionhood"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Summary"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Elaboration",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Additional details about the situation or some element of subject matter related to the artifact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "elaboration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Descriptor"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Evaluation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "a proposition related the situation in the artifact to degree of context's positive regards toward the situation presented in the artifact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "evaluation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Descriptor"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#FeatureOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "feature of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "http://arxiv.org/abs/1808.09602"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#HyponymOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "B is a hyponym of A, B is a  type of A. \n\nE.g.  TUIT is a software library  NLP applications such as machine translation and language generation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "hyponym of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "http://arxiv.org/abs/1808.09602"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Idea",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An Argument Proposition that introduces a proposed insight, hypothesis, design principle, conceptual direction, or motivating proposal that guides the publication's response to an Issue. Ideas often motivate one or more concrete Approaches but may remain more conceptual than implementation-specific."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "idea"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/spar/amo/Argument"
  }, {
    "@id" : "_:genid44"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Interpretation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "a proposition relates the situation presented in the artifact to a framework of ideas not involved in the artifact itself."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "interpretation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Descriptor"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Issue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An Argument Proposition that identifies a research problem, limitation, gap, challenge, question, or motivating condition addressed by the publication. Issues provide the argumentative context to which Ideas and Approaches respond."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "issue"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/spar/amo/Argument"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Material",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Data, datasets, resources, Corpus, Knowledge base. - e.g. image data, speech data, stereo images, bilingual dictionary, paraphrased questions, CoNLL, Panntreebank, WordNet, Wikipedia, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "material"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "http://arxiv.org/abs/1808.09602"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Method",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Methods , models, systems to use, or tools, components of a system, frameworks. - e.g. language model, CORENLP, POS parser, kernel method, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "method"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "http://arxiv.org/abs/1808.09602"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Metric",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Metrics, measures, or entities that can express quality of a system/method. - e.g. F1, BLEU, Precision, Recall, ROC curve, mean reciprocal rank, mean-squared error, robustness, time complexity, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "metric"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "http://arxiv.org/abs/1808.09602"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#PartOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "part of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "http://arxiv.org/abs/1808.09602"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Proposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A source-grounded representation of the meaning expressed by a finite clause in a publication. Propositions preserve what the author asserts, proposes, explains, evaluates, qualifies, or otherwise communicates, and serve as first-class nodes for modeling scholarly discourse and relations that cannot be reduced to entity-to-entity triples."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "proposition"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "http://purl.org/spar/amo/Argument"
    }, {
      "@id" : "https://w3id.org/twc/sudo/ontology#Descriptor"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#Purpose",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A situation to be realized through the activity in the artifact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "purpose"
