  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#concede",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relates one Proposition to another Proposition when the source acknowledges a limitation, exception, counterpoint, or opposing consideration while leaving the target proposition still relevant or defensible. This predicate is derived from the RST Concession relation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ],
