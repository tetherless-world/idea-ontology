    "@value" : "http://purl.org/spar/amo/leadsTo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "leads to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.org/spar/amo/Claim"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#mentions",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relates a Proposition to an Artifact that is explicitly mentioned in the Proposition's source text, without asserting a more specific semantic role between them."
