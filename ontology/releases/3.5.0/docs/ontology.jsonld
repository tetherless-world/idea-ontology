  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relates one Proposition to another Proposition that it contrasts with, opposes, or presents as an alternative perspective. This predicate is derived from the RST Antithesis relation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "contrast"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.org/spar/amo/Argument"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#elaborates",
