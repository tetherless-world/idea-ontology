  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "is valid unless"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#justify",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relates one Proposition to another Proposition when the source provides a reason, explanation, or argumentative basis that makes the target acceptable or warranted. This predicate is derived from the RST Justify relation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "justify"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.org/spar/amo/Argument"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ]
}, {
  "@id" : "https://w3id.org/twc/sudo/ontology#leadsTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A warrant that points to a claim from the related evidence within an argument."
