  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The proposition presents additiona detail about the situation or some element of subject mattern which is presentes in the artifact or inferentially accessible in N in one or more of the way listed below;\nset: member\nabstract : instance \nwhole : part\nprocess : step\nobject : attribute\ngeneralization : specific"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Elaboration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "elaborates"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/twc/sudo/ontology#Artifact"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"
  } ]
}, {
