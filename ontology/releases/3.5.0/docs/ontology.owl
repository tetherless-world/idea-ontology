    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued">
        <rdfs:domain rdf:resource="http://purl.org/spar/fabio/ResearchPaper"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/subject -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/subject">
        <rdfs:domain rdf:resource="http://purl.org/spar/fabio/ResearchPaper"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Recommended practice is to refer to the subject with a URI. If this is not possible or feasible, a literal value that identifies the subject may be provided. Both should preferably refer to a subject in a controlled vocabulary.</rdfs:comment>
        <rdfs:label>Subject</rdfs:label>
        <prov:definition>A topic of the resource.</prov:definition>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:domain rdf:resource="http://purl.org/spar/fabio/ResearchPaper"/>
        <rdfs:comment>A name given to the resource.</rdfs:comment>
        <rdfs:label>Title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ontology/bibo/doi -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ontology/bibo/doi">
        <rdfs:domain rdf:resource="http://purl.org/spar/fabio/ResearchPaper"/>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/position -->


    <owl:DatatypeProperty rdf:about="http://schema.org/position">
        <rdfs:domain rdf:resource="http://purl.org/spar/doco/DiscourseElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The position of an item in a series or sequence of items.</rdfs:comment>
        <rdfs:label>position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#label -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso">
        <rdfs:domain rdf:resource="http://purl.org/spar/fabio/ResearchPaper"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/prov#derivedFrom -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#derivedFrom"/>
    


    <!-- http://www.w3.org/ns/prov#value -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#value"/>
    


    <!-- http://www.w3.org/ns/prov#wasGeneratedBy -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    


    <!-- https://w3id.org/twc/sudo/ontology#citationCount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/twc/sudo/ontology#citationCount">
        <rdfs:domain rdf:resource="http://purl.org/spar/fabio/ResearchPaper"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The number of citations received by a scholarly publication, work, or other citable resource according to a specified bibliographic source or index.</rdfs:comment>
        <rdfs:label>citation count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/ontology/bibo/Proceedings -->


    <owl:Class rdf:about="http://purl.org/ontology/bibo/Proceedings">
        <rdfs:comment>A compilation of documents published from an event, such as a conference.</rdfs:comment>
        <rdfs:label>Proceedings</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/amo/Argument -->


    <rdf:Description rdf:about="http://purl.org/spar/amo/Argument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Proposition"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/spar/amo/Backing"/>
            <rdf:Description rdf:about="http://purl.org/spar/amo/Claim"/>
            <rdf:Description rdf:about="http://purl.org/spar/amo/Evidence"/>
            <rdf:Description rdf:about="http://purl.org/spar/amo/Qualifier"/>
            <rdf:Description rdf:about="http://purl.org/spar/amo/Rebuttal"/>
            <rdf:Description rdf:about="http://purl.org/spar/amo/Warrant"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Approach"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Idea"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Issue"/>
        </owl:disjointUnionOf>
    </rdf:Description>
    


    <!-- http://purl.org/spar/amo/Backing -->


    <rdf:Description rdf:about="http://purl.org/spar/amo/Backing">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
    </rdf:Description>
    


    <!-- http://purl.org/spar/amo/Claim -->


    <rdf:Description rdf:about="http://purl.org/spar/amo/Claim">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
    </rdf:Description>
    


    <!-- http://purl.org/spar/amo/Evidence -->


    <rdf:Description rdf:about="http://purl.org/spar/amo/Evidence">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
    </rdf:Description>
    


    <!-- http://purl.org/spar/amo/Qualifier -->


    <rdf:Description rdf:about="http://purl.org/spar/amo/Qualifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
    </rdf:Description>
    


    <!-- http://purl.org/spar/amo/Rebuttal -->


    <rdf:Description rdf:about="http://purl.org/spar/amo/Rebuttal">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
    </rdf:Description>
    


    <!-- http://purl.org/spar/amo/Warrant -->


    <rdf:Description rdf:about="http://purl.org/spar/amo/Warrant">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
    </rdf:Description>
    


    <!-- http://purl.org/spar/doco/DiscourseElement -->


    <owl:Class rdf:about="http://purl.org/spar/doco/DiscourseElement">
        <rdfs:comment>An element of a document that carries out a rhetorical function.</rdfs:comment>
        <rdfs:label>discourse element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/doco/Paragraph -->


    <owl:Class rdf:about="http://purl.org/spar/doco/Paragraph">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/doco/DiscourseElement"/>
        <rdfs:comment>A self-contained unit of discourse that deals with a particular point or idea. Paragraphs contains one or more sentences. The start of a paragraph is indicated by beginning on a new line, which may be indented or separated by a small vertical space by the preceding paragraph.</rdfs:comment>
        <rdfs:label>paragraph</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/doco/Section -->


    <owl:Class rdf:about="http://purl.org/spar/doco/Section">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/doco/DiscourseElement"/>
        <rdfs:comment>A logical division of the text, usually numbered and/or titled, which may contain subsections.</rdfs:comment>
        <rdfs:label>section</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/doco/SectionTitle -->


    <owl:Class rdf:about="http://purl.org/spar/doco/SectionTitle">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/doco/DiscourseElement"/>
        <rdfs:comment>The title of a section.</rdfs:comment>
        <rdfs:label>section title</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/doco/Sentence -->


    <owl:Class rdf:about="http://purl.org/spar/doco/Sentence">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/doco/DiscourseElement"/>
        <rdfs:comment>An expression in natural language forming a single grammatical unit. A sentence minimally consists of a subject and an intransitive verb, or a subject, a transitive verb and an object, and may include additional dependent clauses. In written text, a sentence is always terminated by a full stop. A sentence can include words grouped meaningfully to express a statement, a question, an exclamation, a request or a command.</rdfs:comment>
        <rdfs:label>sentence</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/ResearchPaper -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/ResearchPaper">
        <rdfs:comment>A scholarly work that reports original research contributions addressing theoretical, analytical or experimental aspects of a particular scholarly domain.

E.g. see http://iswc2018.semanticweb.org/call-for-research-track-papers/.</rdfs:comment>
        <rdfs:label>research paper</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Agent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent"/>
    


    <!-- http://xmlns.com/foaf/0.1/Person -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
        <rdfs:comment>A Person.</rdfs:comment>
        <rdfs:label>(foaf) Person</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Approach -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Approach">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
        <rdfs:comment>An Argument Proposition that presents, applies, or operationalizes a method, system, framework, dataset construction process, experimental setup, or other scholarly means used to address an Issue or realize an Idea. Approaches capture how a publication proposes to act on, investigate, or solve a research problem.</rdfs:comment>
        <rdfs:label>approach</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Artifact -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Artifact">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/twc/sudo/ontology#contextualizes"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spar/amo/Argument"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/twc/sudo/ontology#motivates"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spar/amo/Argument"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Material"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Method"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Metric"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Task"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Term"/>
        </owl:disjointUnionOf>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Cause -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Cause">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Circumstance -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Circumstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/twc/sudo/ontology#contextualizes"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/twc/sudo/ontology#Artifact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Concept -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Concept">
        <owl:disjointWith rdf:resource="https://w3id.org/twc/sudo/ontology#Proposition"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Condition -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Condition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Descriptor -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Descriptor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Proposition"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Cause"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Circumstance"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Condition"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Elaboration"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Evaluation"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Interpretation"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Purpose"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Restatement"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Result"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Solutionhood"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Summary"/>
        </owl:disjointUnionOf>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Elaboration -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Elaboration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Evaluation -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Evaluation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Idea -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Idea">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/twc/sudo/ontology#motivates"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/twc/sudo/ontology#Approach"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An Argument Proposition that introduces a proposed insight, hypothesis, design principle, conceptual direction, or motivating proposal that guides the publication&apos;s response to an Issue. Ideas often motivate one or more concrete Approaches but may remain more conceptual than implementation-specific.</rdfs:comment>
        <rdfs:label>idea</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Interpretation -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Interpretation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Issue -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Issue">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/amo/Argument"/>
        <rdfs:comment>An Argument Proposition that identifies a research problem, limitation, gap, challenge, question, or motivating condition addressed by the publication. Issues provide the argumentative context to which Ideas and Approaches respond.</rdfs:comment>
        <rdfs:label>issue</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Material -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Material">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Artifact"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Method -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Method">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Artifact"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Metric -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Metric">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Artifact"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Proposition -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Proposition">
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/spar/amo/Argument"/>
            <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Descriptor"/>
        </owl:disjointUnionOf>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Purpose -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Purpose">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Restatement -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Restatement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Result -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Result">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Solutionhood -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Solutionhood">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Summary -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Summary">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Descriptor"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Task -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Task">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Artifact"/>
    </owl:Class>
    


    <!-- https://w3id.org/twc/sudo/ontology#Term -->


    <owl:Class rdf:about="https://w3id.org/twc/sudo/ontology#Term">
        <rdfs:subClassOf rdf:resource="https://w3id.org/twc/sudo/ontology#Artifact"/>
    </owl:Class>
    


