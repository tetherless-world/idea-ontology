    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
        <rdfs:comment>Recommended practice is to identify the creator with a URI. If this is not possible or feasible, a literal value that identifies the creator may be provided.</rdfs:comment>
        <rdfs:label>Creator</rdfs:label>
        <prov:definition>An entity responsible for making the resource.</prov:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/dc/terms/issued">
        <rdfs:comment>Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty.</rdfs:comment>
        <rdfs:label>Date Issued</rdfs:label>
        <prov:definition>Date of formal issuance of the resource.</prov:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Artifact">
        <rdfs:comment>A source-grounded, paper-local mention of a scholarly object, method, dataset, metric, task, term, or other noun-phrase referent. Artifacts preserve the original textual expression of concepts within a publication and may be aligned to canonical Concepts across papers.</rdfs:comment>
        <rdfs:label>artifact</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Cause">
        <rdfs:comment>A situation that, by means other than motivating a violational or non-violational action caused the situation presented in the artifact.</rdfs:comment>
        <rdfs:label>cause</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Circumstance">
        <rdfs:comment>The proposition providing the situation presents the framework for interpreting the artifact.</rdfs:comment>
        <rdfs:label>circumstance</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Concept">
        <rdfs:comment>A canonical scholarly concept that provides a cross-publication identity for recurring paper-local Artifact mentions. Concepts abstract over source-specific phrasings while preserving links to the Artifacts through which they are expressed in individual publications</rdfs:comment>
        <rdfs:label>concept</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Condition">
        <rdfs:comment>A realization of the situation presented in the proposition enables the realization of the situation presented in the artifact.</rdfs:comment>
        <rdfs:label>condition</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Descriptor">
        <rdfs:comment>A Proposition that contextualizes, qualifies, characterizes, or elaborates an Artifact or another Proposition rather than advancing the publication&apos;s main research argument. Descriptors preserve local explanatory, evaluative, definitional, and conditional details that give scholarly concepts and statements their paper-specific meaning.</rdfs:comment>
        <rdfs:label>descriptor</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Elaboration">
        <rdfs:comment>Additional details about the situation or some element of subject matter related to the artifact.</rdfs:comment>
        <rdfs:label>elaboration</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Evaluation">
        <rdfs:comment>a proposition related the situation in the artifact to degree of context&apos;s positive regards toward the situation presented in the artifact.</rdfs:comment>
        <rdfs:label>evaluation</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#HyponymOf">
        <rdfs:comment>B is a hyponym of A, B is a  type of A. 

E.g.  TUIT is a software library  NLP applications such as machine translation and language generation</rdfs:comment>
        <rdfs:label>hyponym of</rdfs:label>
        <rdfs:seeAlso>http://arxiv.org/abs/1808.09602</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Interpretation">
        <rdfs:comment>a proposition relates the situation presented in the artifact to a framework of ideas not involved in the artifact itself.</rdfs:comment>
        <rdfs:label>interpretation</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Material">
        <rdfs:comment>Data, datasets, resources, Corpus, Knowledge base. - e.g. image data, speech data, stereo images, bilingual dictionary, paraphrased questions, CoNLL, Panntreebank, WordNet, Wikipedia, etc.</rdfs:comment>
        <rdfs:label>material</rdfs:label>
        <rdfs:seeAlso>http://arxiv.org/abs/1808.09602</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Method">
        <rdfs:comment>Methods , models, systems to use, or tools, components of a system, frameworks. - e.g. language model, CORENLP, POS parser, kernel method, etc.</rdfs:comment>
        <rdfs:label>method</rdfs:label>
        <rdfs:seeAlso>http://arxiv.org/abs/1808.09602</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Metric">
        <rdfs:comment>Metrics, measures, or entities that can express quality of a system/method. - e.g. F1, BLEU, Precision, Recall, ROC curve, mean reciprocal rank, mean-squared error, robustness, time complexity, etc.</rdfs:comment>
        <rdfs:label>metric</rdfs:label>
        <rdfs:seeAlso>http://arxiv.org/abs/1808.09602</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Proposition">
        <rdfs:comment>A source-grounded representation of the meaning expressed by a finite clause in a publication. Propositions preserve what the author asserts, proposes, explains, evaluates, qualifies, or otherwise communicates, and serve as first-class nodes for modeling scholarly discourse and relations that cannot be reduced to entity-to-entity triples.</rdfs:comment>
        <rdfs:label>proposition</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Purpose">
        <rdfs:comment>A situation to be realized through the activity in the artifact.</rdfs:comment>
        <rdfs:label>purpose</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Restatement">
        <rdfs:comment>a proposition restates the artifact, where the proposition and the artifact are of comparable bulk.</rdfs:comment>
        <rdfs:label>restatement</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Result">
        <rdfs:comment>A Proposition presets a situation that could ahve been caused by the situation presented in the artifact.</rdfs:comment>
        <rdfs:label>result</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Solutionhood">
        <rdfs:comment>The proposition representing the situation that solves by the artifact.</rdfs:comment>
        <rdfs:label>solutionhood</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Summary">
        <rdfs:comment>A restatement of the content of the artifact, that is shorter in bulk.</rdfs:comment>
        <rdfs:label>summary</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Task">
        <rdfs:comment>Applications, problems to solve, systems to construct. - e.g. information extraction, machine reading system, image segmentation, etc.</rdfs:comment>
        <rdfs:label>task</rdfs:label>
        <rdfs:seeAlso>http://arxiv.org/abs/1808.09602</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#Term">
        <rdfs:comment>General terms or pronouns that may refer to a entity but are not themselves informative, often used as connection words.</rdfs:comment>
        <rdfs:label>term</rdfs:label>
        <rdfs:seeAlso>http://arxiv.org/abs/1808.09602</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#causes">
        <rdfs:comment>the situation presented in the proposition as a cause for the volitional or non-violation action presented in the artifact</rdfs:comment>
        <rdfs:label>causes</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#concede">
        <rdfs:comment>Relates one Proposition to another Proposition when the source acknowledges a limitation, exception, counterpoint, or opposing consideration while leaving the target proposition still relevant or defensible. This predicate is derived from the RST Concession relation.</rdfs:comment>
        <rdfs:label>concede</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#condition">
        <rdfs:comment>recognizes how the realization of the situation presented in artifact depends on the realization of the situation presented in the proposition.</rdfs:comment>
        <rdfs:label>condition</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#contextualizes">
        <rdfs:comment>the proposition provides the framework for interpreting the reference artifact.</rdfs:comment>
        <rdfs:label>contextualizes</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#contrast">
        <rdfs:comment>Relates one Proposition to another Proposition that it contrasts with, opposes, or presents as an alternative perspective. This predicate is derived from the RST Antithesis relation.</rdfs:comment>
        <rdfs:label>contrast</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#elaborates">
        <rdfs:comment>The proposition presents additiona detail about the situation or some element of subject mattern which is presentes in the artifact or inferentially accessible in N in one or more of the way listed below;
set: member
abstract : instance 
whole : part
process : step
object : attribute
generalization : specific</rdfs:comment>
        <rdfs:label>elaborates</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#enables">
        <rdfs:comment>potential ability to perform the action presented in artifact increases</rdfs:comment>
        <rdfs:label>enables</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#evaluates">
        <rdfs:comment>situation presented in the proposition assess the sutiation presented in the artifact and recognizes the value it assigns.</rdfs:comment>
        <rdfs:label>evaluates</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#evidence">
        <rdfs:label>evidence</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#forces">
        <rdfs:comment>A qualifier that expresses as degree of force concerning a claim of an argument.</rdfs:comment>
        <rdfs:isDefinedBy>http://purl.org/spar/amo/forces</rdfs:isDefinedBy>
        <rdfs:label>forces</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#interprets">
        <rdfs:comment>the situation presented in the artifact to a framework of ideas not involved in the knowledge presented in the artifact itself.</rdfs:comment>
        <rdfs:label>interprets</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#justify">
        <rdfs:comment>Relates one Proposition to another Proposition when the source provides a reason, explanation, or argumentative basis that makes the target acceptable or warranted. This predicate is derived from the RST Justify relation.</rdfs:comment>
        <rdfs:label>justify</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#leadsTo">
        <rdfs:comment>A warrant that points to a claim from the related evidence within an argument.</rdfs:comment>
        <rdfs:isDefinedBy>http://purl.org/spar/amo/leadsTo</rdfs:isDefinedBy>
        <rdfs:label>leads to</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#mentions">
        <rdfs:comment>Relates a Proposition to an Artifact that is explicitly mentioned in the Proposition&apos;s source text, without asserting a more specific semantic role between them.</rdfs:comment>
        <rdfs:label>mentions</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#motivates">
        <rdfs:comment>desire to perform action presented in the artifact is increased</rdfs:comment>
        <rdfs:label>motivates</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#proves">
        <rdfs:comment>An evidence that founds a claim of an argument.</rdfs:comment>
        <rdfs:isDefinedBy>http://purl.org/spar/amo/proves</rdfs:isDefinedBy>
        <rdfs:label>proves</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#purposes">
        <rdfs:comment>the activity in the artifact is initiated in order to realize the proposition.</rdfs:comment>
        <rdfs:label>purposes</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#responsesTo">
        <rdfs:comment>Relates a Proposition to another Proposition that it addresses as a motivating problem, question, need, or proposed response. This predicate is used both when an Idea responds to an Issue and when an Approach responds to an Issue by operationalizing a way to address it.</rdfs:comment>
        <rdfs:label>response to</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#restates">
        <rdfs:comment>a proposition as a restatement of the artifact.</rdfs:comment>
        <rdfs:label>restates</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#result">
        <rdfs:comment>recognizes that the situation presented in the artifact, could be a cuase for the action or situation presented in the proposition.</rdfs:comment>
        <rdfs:label>result</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#solves">
        <rdfs:comment>The artifact is a solution to the problem stated in the proposition.</rdfs:comment>
        <rdfs:label>solves</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#summarizes">
        <rdfs:comment>a proposition as a shorter restatement of the artifact.</rdfs:comment>
        <rdfs:label>summarizes</rdfs:label>
        <rdfs:seeAlso>https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf</rdfs:seeAlso>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#supports">
        <rdfs:comment>An evidence that supports a warrant of an argument.</rdfs:comment>
        <rdfs:isDefinedBy>http://purl.org/spar/amo/supports</rdfs:isDefinedBy>
        <rdfs:label>supports</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/twc/sudo/ontology#usedFor">
        <rdfs:comment>B is used for A, B models A, A is  trained on B, B exploits A, A is based on B. 

E.g.  The TISPER system has been designed to enable many text applications.</rdfs:comment>
        <rdfs:label>used for</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://arxiv.org/abs/1808.09602</rdfs:seeAlso>
    </rdf:Description>
