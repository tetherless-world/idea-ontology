@prefix : <https://w3id.org/twc/sudo/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/twc/sudo/ontology#> .

<https://w3id.org/twc/sudo/ontology> rdf:type owl:Ontology ;
                                      owl:versionIRI <https://w3id.org/twc/sudo/ontology/releases/3.5.0> ;
                                      owl:imports <http://purl.org/spar/amo> ,
                                                  <http://www.w3.org/ns/prov-o-20130430> ;
                                      <http://purl.org/dc/elements/1.1/abstract> "The SUDO Ontology is an ontology for representing ideas, issues, arguments, and approaches in scientific research and scholarly communication." ;
                                      <http://purl.org/dc/elements/1.1/creator> "Nipun D. Pathirage" ;
                                      <http://purl.org/dc/elements/1.1/description> <https://tetherless-world.github.io/sudo-ontology/ontology/idea_graph_figure.svg> ,
                                                                                    """Scientific literature communicates knowledge not only through data and results but also through structured scholarly discourse, including motivations, problems, proposed ideas, supporting evidence, and claims. These abstract components are distributed across documents and connected through citations, making them difficult to extract and represent automatically. Existing scholarly knowledge graphs largely focus on metadata or citation networks, offering limited support for modeling scientific intent and argumentation.

The SUDO Graph addresses this limitation by introducing an ontology-centered framework that captures both concrete document structure and abstract scholarly discourse in a unified knowledge graph. The framework integrates layout-aware document parsing, ontology-guided extraction with large language models, and structured RDF instantiation. In addition, it models provenance information for all knowledge graph construction operations and adopts the PAV ontology to manage versioning and lineage of extracted instances. This design enables interpretable, evolvable, and semantically grounded scholarly knowledge graphs suitable for advanced querying, reasoning, and machine-assisted knowledge discovery.""" ;
                                      <http://purl.org/dc/elements/1.1/license> "https://opensource.org/licenses/MIT"^^<xsd:anyURI> ;
                                      <http://purl.org/dc/elements/1.1/modified> "2025-12-29" ;
                                      <http://purl.org/dc/elements/1.1/publisher> "Tetherless World Constellation | Rensselaer Polytechnic Institute" ;
                                      <http://purl.org/dc/elements/1.1/title> "SUDO Ontology" ;
                                      <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-9313-0925> ;
                                      <http://purl.org/vocab/vann/preferredNamespaceUri> """
        https://w3id.org/twc/sudo/ontology#
        """ ;
                                      rdfs:comment "The Idea Graph is a framework for constructing ontology-driven scholarly knowledge graphs from scientific literature. It models scientific publications across three interconnected layers: document structure, extracted information, and abstract scholarly discourse such as research problems, ideas, evidence, and claims. The framework employs a discourse-aware ontology inspired by argumentation theory to align textual grounding, rhetorical intent, and citation attribution. An end-to-end pipeline transforms scientific PDFs into RDF graphs using layout-preserving parsing and ontology-guided large language model extraction. To ensure transparency and reproducibility, the system explicitly represents knowledge graph construction provenance and integrates the PAV ontology for instance-level versioning and lineage tracking. The resulting graphs support semantic querying, retrieval-augmented generation, and interactive visualization of discourse structures and citation roles." ;
                                      owl:backwardCompatibleWith <https://w3id.org/twc/sudo/ontology/releases/3.2.0> ;
                                      owl:priorVersion <https://w3id.org/twc/sudo/ontology/releases/3.2.0> ;
                                      owl:versionInfo "3.4.0" ;
                                      <http://www.w3.org/2004/02/skos/core#changeNote> "Formatting and URI update of SUDO Ontology version 3.2.0." ;
                                      <https://www.omg.org/spec/Commons/AnnotationVocabulary/copyright> "Copyright (c) 2026 TWC" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/abstract
<http://purl.org/dc/elements/1.1/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/license
<http://purl.org/dc/elements/1.1/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/modified
<http://purl.org/dc/elements/1.1/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/publisher
<http://purl.org/dc/elements/1.1/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty ;
                                   rdfs:range <http://xmlns.com/foaf/0.1/Person> .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdfs:range rdfs:Literal .


###  http://purl.org/ontology/bibo/doi
<http://purl.org/ontology/bibo/doi> rdfs:range xsd:anyURI .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdfs:range xsd:anyURI .


###  http://www.w3.org/2004/02/skos/core#changeNote
<http://www.w3.org/2004/02/skos/core#changeNote> rdf:type owl:AnnotationProperty .


###  https://www.omg.org/spec/Commons/AnnotationVocabulary/copyright
<https://www.omg.org/spec/Commons/AnnotationVocabulary/copyright> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  xsd:anyURI
<xsd:anyURI> rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> .


###  http://purl.org/dc/terms/isPartOf
<http://purl.org/dc/terms/isPartOf> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> ;
                                    rdfs:range <http://purl.org/ontology/bibo/Proceedings> .


###  http://purl.org/spar/cito/cites
<http://purl.org/spar/cito/cites> rdf:type owl:ObjectProperty ,
                                           owl:AsymmetricProperty ;
                                  rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> ;
                                  rdfs:range <http://purl.org/spar/fabio/ResearchPaper> ;
                                  rdfs:comment "The citing entity cites the cited entity, either directly and explicitly (as in the reference list of a journal article), indirectly (e.g. by citing a more recent paper by the same group on the same topic), or implicitly (e.g. as in artistic quotations or parodies, or in cases of plagiarism)." ;
                                  rdfs:label "cites" .


###  http://www.essepuntato.it/2008/12/pattern#contains
<http://www.essepuntato.it/2008/12/pattern#contains> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/spar/doco/DiscourseElement> ;
                                                     rdfs:range <http://purl.org/spar/doco/DiscourseElement> ;
                                                     rdfs:comment "A structured element contains another generic element." ;
                                                     rdfs:label "contains" .


###  http://www.essepuntato.it/2008/12/pattern#isContainedByAsHeader
<http://www.essepuntato.it/2008/12/pattern#isContainedByAsHeader> rdf:type owl:ObjectProperty ;
                                                                  rdfs:domain <http://purl.org/spar/doco/Section> ;
                                                                  rdfs:range <http://purl.org/spar/doco/SectionTitle> .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:ObjectProperty ,
                                                        owl:SymmetricProperty ,
                                                        owl:TransitiveProperty ;
                                               rdfs:domain :Concept ;
                                               rdfs:range :Concept ;
                                               rdfs:comment """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties.
The range of skos:altLabel is the class of RDF plain literals.""" ;
                                               rdfs:label "alternative label" .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:ObjectProperty ,
                                                          owl:SymmetricProperty ,
                                                          owl:TransitiveProperty ;
                                                 rdfs:domain :Concept ;
                                                 rdfs:range :Concept ;
                                                 rdfs:comment "skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of \"compound errors\" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property." ;
                                                 rdfs:label "has close match" .


###  https://w3id.org/twc/sudo/ontology#HyponymOf
:HyponymOf rdf:type owl:ObjectProperty ;
           rdfs:domain :Artifact ;
           rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#causes
:causes rdf:type owl:ObjectProperty ;
        rdfs:domain :Cause ;
        rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#concede
:concede rdf:type owl:ObjectProperty ;
         rdfs:domain :Artifact ;
         rdfs:range <http://purl.org/spar/amo/Argument> .


###  https://w3id.org/twc/sudo/ontology#condition
:condition rdf:type owl:ObjectProperty ;
           rdfs:domain :Condition ;
           rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#contextualizes
:contextualizes rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Artifact
                                            :Circumstance
                                          )
                            ] ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( <http://purl.org/spar/amo/Argument>
                                           :Artifact
                                         )
                           ] .


###  https://w3id.org/twc/sudo/ontology#contrast
:contrast rdf:type owl:ObjectProperty ;
          rdfs:domain :Artifact ;
          rdfs:range <http://purl.org/spar/amo/Argument> .


###  https://w3id.org/twc/sudo/ontology#elaborates
:elaborates rdf:type owl:ObjectProperty ;
            rdfs:domain :Elaboration ;
            rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#enables
:enables rdf:type owl:ObjectProperty ;
         rdfs:domain :Artifact ;
         rdfs:range <http://purl.org/spar/amo/Argument> .


###  https://w3id.org/twc/sudo/ontology#evaluates
:evaluates rdf:type owl:ObjectProperty ;
           rdfs:domain :Evaluation ;
           rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#evidence
:evidence rdf:type owl:ObjectProperty ;
          rdfs:domain :Approach ;
          rdfs:range <http://purl.org/spar/amo/Evidence> .


###  https://w3id.org/twc/sudo/ontology#featureOf
:featureOf rdf:type owl:ObjectProperty ;
           rdfs:domain :Artifact ;
           rdfs:range :Artifact ;
           rdfs:comment """B belongs to A, B is a feature of  A, B is under A domain. 

E.g.  prior knowledge of the model  genre-specific regularities of discourse structure English text in science domain""" ;
           rdfs:label "feature of" ;
           rdfs:seeAlso "http://arxiv.org/abs/1808.09602"^^xsd:anyURI .


###  https://w3id.org/twc/sudo/ontology#forces
:forces rdf:type owl:ObjectProperty ;
        rdfs:domain <http://purl.org/spar/amo/Qualifier> ;
        rdfs:range <http://purl.org/spar/amo/Claim> .


###  https://w3id.org/twc/sudo/ontology#interprets
:interprets rdf:type owl:ObjectProperty ;
            rdfs:domain :Interpretation ;
            rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#justify
:justify rdf:type owl:ObjectProperty ;
         rdfs:domain :Artifact ;
         rdfs:range <http://purl.org/spar/amo/Argument> .


###  https://w3id.org/twc/sudo/ontology#leadsTo
:leadsTo rdf:type owl:ObjectProperty ;
         rdfs:domain <http://purl.org/spar/amo/Warrant> ;
         rdfs:range <http://purl.org/spar/amo/Claim> .


###  https://w3id.org/twc/sudo/ontology#mentions
:mentions rdf:type owl:ObjectProperty ;
          rdfs:domain :Proposition ;
          rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#motivates
:motivates rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Artifact
                                       :Idea
                                     )
                       ] ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( <http://purl.org/spar/amo/Argument>
                                      :Approach
                                    )
                      ] .


###  https://w3id.org/twc/sudo/ontology#partOf
:partOf rdf:type owl:ObjectProperty ;
        rdfs:domain :Artifact ;
        rdfs:range :Artifact ;
        rdfs:comment """B is a part of A... 
E.g.  The system includes two models: speech recognition and natural language understanding  We inc""" ;
        rdfs:label "part of" ;
        rdfs:seeAlso "http://arxiv.org/abs/1808.09602"^^xsd:anyURI .


###  https://w3id.org/twc/sudo/ontology#proves
:proves rdf:type owl:ObjectProperty ;
        rdfs:domain <http://purl.org/spar/amo/Evidence> ;
        rdfs:range <http://purl.org/spar/amo/Claim> .


###  https://w3id.org/twc/sudo/ontology#purposes
:purposes rdf:type owl:ObjectProperty ;
          rdfs:domain :Purpose ;
          rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#responsesTo
:responsesTo rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Approach
                                         :Idea
                                       )
                         ] ;
             rdfs:range :Issue .


###  https://w3id.org/twc/sudo/ontology#restates
:restates rdf:type owl:ObjectProperty ;
          rdfs:domain :Restatement ;
          rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#result
:result rdf:type owl:ObjectProperty ;
        rdfs:domain :Result ;
        rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#solves
:solves rdf:type owl:ObjectProperty ;
        rdfs:domain :Solutionhood ;
        rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#summarizes
:summarizes rdf:type owl:ObjectProperty ;
            rdfs:domain :Summary ;
            rdfs:range :Artifact .


###  https://w3id.org/twc/sudo/ontology#supports
:supports rdf:type owl:ObjectProperty ;
          rdfs:domain :Artifact ;
          rdfs:range <http://purl.org/spar/amo/Argument> .


###  https://w3id.org/twc/sudo/ontology#usedFor
:usedFor rdf:type owl:ObjectProperty ;
         rdfs:domain :Artifact ;
         rdfs:range :Artifact .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> .


###  http://purl.org/dc/terms/subject
<http://purl.org/dc/terms/subject> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Recommended practice is to refer to the subject with a URI. If this is not possible or feasible, a literal value that identifies the subject may be provided. Both should preferably refer to a subject in a controlled vocabulary." ;
                                   rdfs:label "Subject" ;
                                   <http://www.w3.org/ns/prov#definition> "A topic of the resource." .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> ;
                                 rdfs:comment "A name given to the resource." ;
                                 rdfs:label "Title" .


###  http://purl.org/ontology/bibo/doi
<http://purl.org/ontology/bibo/doi> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> .


###  http://schema.org/position
<http://schema.org/position> rdf:type owl:DatatypeProperty ;
                             rdfs:domain <http://purl.org/spar/doco/DiscourseElement> ;
                             rdfs:range xsd:integer ;
                             rdfs:comment "The position of an item in a series or sequence of items." ;
                             rdfs:label "position" .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:DatatypeProperty .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdf:type owl:DatatypeProperty ;
             rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> .


###  http://www.w3.org/ns/prov#derivedFrom
<http://www.w3.org/ns/prov#derivedFrom> rdf:type owl:DatatypeProperty .


###  http://www.w3.org/ns/prov#value
<http://www.w3.org/ns/prov#value> rdf:type owl:DatatypeProperty .


###  http://www.w3.org/ns/prov#wasGeneratedBy
<http://www.w3.org/ns/prov#wasGeneratedBy> rdf:type owl:DatatypeProperty .


###  https://w3id.org/twc/sudo/ontology#citationCount
:citationCount rdf:type owl:DatatypeProperty ;
               rdfs:domain <http://purl.org/spar/fabio/ResearchPaper> ;
               rdfs:range xsd:integer ;
               rdfs:comment "The number of citations received by a scholarly publication, work, or other citable resource according to a specified bibliographic source or index." ;
               rdfs:label "citation count" .


#################################################################
#    Classes
#################################################################

###  http://purl.org/ontology/bibo/Proceedings
<http://purl.org/ontology/bibo/Proceedings> rdf:type owl:Class ;
                                            rdfs:comment "A compilation of documents published from an event, such as a conference." ;
                                            rdfs:label "Proceedings" .


###  http://purl.org/spar/amo/Argument
<http://purl.org/spar/amo/Argument> rdfs:subClassOf :Proposition ;
                                    owl:disjointUnionOf ( <http://purl.org/spar/amo/Backing>
                                                          <http://purl.org/spar/amo/Claim>
                                                          <http://purl.org/spar/amo/Evidence>
                                                          <http://purl.org/spar/amo/Qualifier>
                                                          <http://purl.org/spar/amo/Rebuttal>
                                                          <http://purl.org/spar/amo/Warrant>
                                                          :Approach
                                                          :Idea
                                                          :Issue
                                                        ) .


###  http://purl.org/spar/amo/Backing
<http://purl.org/spar/amo/Backing> rdfs:subClassOf <http://purl.org/spar/amo/Argument> .


###  http://purl.org/spar/amo/Claim
<http://purl.org/spar/amo/Claim> rdfs:subClassOf <http://purl.org/spar/amo/Argument> .


###  http://purl.org/spar/amo/Evidence
<http://purl.org/spar/amo/Evidence> rdfs:subClassOf <http://purl.org/spar/amo/Argument> .


###  http://purl.org/spar/amo/Qualifier
<http://purl.org/spar/amo/Qualifier> rdfs:subClassOf <http://purl.org/spar/amo/Argument> .


###  http://purl.org/spar/amo/Rebuttal
<http://purl.org/spar/amo/Rebuttal> rdfs:subClassOf <http://purl.org/spar/amo/Argument> .


###  http://purl.org/spar/amo/Warrant
<http://purl.org/spar/amo/Warrant> rdfs:subClassOf <http://purl.org/spar/amo/Argument> .


###  http://purl.org/spar/doco/DiscourseElement
<http://purl.org/spar/doco/DiscourseElement> rdf:type owl:Class ;
                                             rdfs:comment "An element of a document that carries out a rhetorical function." ;
                                             rdfs:label "discourse element" .


###  http://purl.org/spar/doco/Paragraph
<http://purl.org/spar/doco/Paragraph> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://purl.org/spar/doco/DiscourseElement> ;
                                      rdfs:comment "A self-contained unit of discourse that deals with a particular point or idea. Paragraphs contains one or more sentences. The start of a paragraph is indicated by beginning on a new line, which may be indented or separated by a small vertical space by the preceding paragraph." ;
                                      rdfs:label "paragraph" .


###  http://purl.org/spar/doco/Section
<http://purl.org/spar/doco/Section> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://purl.org/spar/doco/DiscourseElement> ;
                                    rdfs:comment "A logical division of the text, usually numbered and/or titled, which may contain subsections." ;
                                    rdfs:label "section" .


###  http://purl.org/spar/doco/SectionTitle
<http://purl.org/spar/doco/SectionTitle> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://purl.org/spar/doco/DiscourseElement> ;
                                         rdfs:comment "The title of a section." ;
                                         rdfs:label "section title" .


###  http://purl.org/spar/doco/Sentence
<http://purl.org/spar/doco/Sentence> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://purl.org/spar/doco/DiscourseElement> ;
                                     rdfs:comment "An expression in natural language forming a single grammatical unit. A sentence minimally consists of a subject and an intransitive verb, or a subject, a transitive verb and an object, and may include additional dependent clauses. In written text, a sentence is always terminated by a full stop. A sentence can include words grouped meaningfully to express a statement, a question, an exclamation, a request or a command." ;
                                     rdfs:label "sentence" .


###  http://purl.org/spar/fabio/ResearchPaper
<http://purl.org/spar/fabio/ResearchPaper> rdf:type owl:Class ;
                                           rdfs:comment """A scholarly work that reports original research contributions addressing theoretical, analytical or experimental aspects of a particular scholarly domain.

E.g. see http://iswc2018.semanticweb.org/call-for-research-track-papers/.""" ;
                                           rdfs:label "research paper" .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class ;
                                   rdfs:comment "A Person." ;
                                   rdfs:label "(foaf) Person" .


###  https://w3id.org/twc/sudo/ontology#Approach
:Approach rdf:type owl:Class ;
          rdfs:subClassOf <http://purl.org/spar/amo/Argument> ;
          rdfs:comment "An Argument Proposition that presents, applies, or operationalizes a method, system, framework, dataset construction process, experimental setup, or other scholarly means used to address an Issue or realize an Idea. Approaches capture how a publication proposes to act on, investigate, or solve a research problem." ;
          rdfs:label "approach" .


###  https://w3id.org/twc/sudo/ontology#Artifact
:Artifact rdf:type owl:Class ;
          rdfs:subClassOf :Concept ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :contextualizes ;
                            owl:allValuesFrom <http://purl.org/spar/amo/Argument>
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :motivates ;
                            owl:allValuesFrom <http://purl.org/spar/amo/Argument>
                          ] ;
          owl:disjointUnionOf ( :Material
                                :Method
                                :Metric
                                :Task
                                :Term
                              ) .


###  https://w3id.org/twc/sudo/ontology#Cause
:Cause rdf:type owl:Class ;
       rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Circumstance
:Circumstance rdf:type owl:Class ;
              rdfs:subClassOf :Descriptor ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :contextualizes ;
                                owl:allValuesFrom :Artifact
                              ] .


###  https://w3id.org/twc/sudo/ontology#Concept
:Concept rdf:type owl:Class ;
         owl:disjointWith :Proposition .


###  https://w3id.org/twc/sudo/ontology#Condition
:Condition rdf:type owl:Class ;
           rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Descriptor
:Descriptor rdf:type owl:Class ;
            rdfs:subClassOf :Proposition ;
            owl:disjointUnionOf ( :Cause
                                  :Circumstance
                                  :Condition
                                  :Elaboration
                                  :Evaluation
                                  :Interpretation
                                  :Purpose
                                  :Restatement
                                  :Result
                                  :Solutionhood
                                  :Summary
                                ) .


###  https://w3id.org/twc/sudo/ontology#Elaboration
:Elaboration rdf:type owl:Class ;
             rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Evaluation
:Evaluation rdf:type owl:Class ;
            rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Idea
:Idea rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.org/spar/amo/Argument> ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :motivates ;
                        owl:allValuesFrom :Approach
                      ] ;
      rdfs:comment "An Argument Proposition that introduces a proposed insight, hypothesis, design principle, conceptual direction, or motivating proposal that guides the publication's response to an Issue. Ideas often motivate one or more concrete Approaches but may remain more conceptual than implementation-specific." ;
      rdfs:label "idea" .


###  https://w3id.org/twc/sudo/ontology#Interpretation
:Interpretation rdf:type owl:Class ;
                rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Issue
:Issue rdf:type owl:Class ;
       rdfs:subClassOf <http://purl.org/spar/amo/Argument> ;
       rdfs:comment "An Argument Proposition that identifies a research problem, limitation, gap, challenge, question, or motivating condition addressed by the publication. Issues provide the argumentative context to which Ideas and Approaches respond." ;
       rdfs:label "issue" .


###  https://w3id.org/twc/sudo/ontology#Material
:Material rdf:type owl:Class ;
          rdfs:subClassOf :Artifact .


###  https://w3id.org/twc/sudo/ontology#Method
:Method rdf:type owl:Class ;
        rdfs:subClassOf :Artifact .


###  https://w3id.org/twc/sudo/ontology#Metric
:Metric rdf:type owl:Class ;
        rdfs:subClassOf :Artifact .


###  https://w3id.org/twc/sudo/ontology#Proposition
:Proposition rdf:type owl:Class ;
             owl:disjointUnionOf ( <http://purl.org/spar/amo/Argument>
                                   :Descriptor
                                 ) .


###  https://w3id.org/twc/sudo/ontology#Purpose
:Purpose rdf:type owl:Class ;
         rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Restatement
:Restatement rdf:type owl:Class ;
             rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Result
:Result rdf:type owl:Class ;
        rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Solutionhood
:Solutionhood rdf:type owl:Class ;
              rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Summary
:Summary rdf:type owl:Class ;
         rdfs:subClassOf :Descriptor .


###  https://w3id.org/twc/sudo/ontology#Task
:Task rdf:type owl:Class ;
      rdfs:subClassOf :Artifact .


###  https://w3id.org/twc/sudo/ontology#Term
:Term rdf:type owl:Class ;
      rdfs:subClassOf :Artifact .


