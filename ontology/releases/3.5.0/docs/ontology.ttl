#################################################################
#    Annotations
#################################################################

<http://purl.org/dc/terms/creator> rdfs:comment "Recommended practice is to identify the creator with a URI. If this is not possible or feasible, a literal value that identifies the creator may be provided." ;
                                   rdfs:label "Creator" ;
                                   <http://www.w3.org/ns/prov#definition> "An entity responsible for making the resource." .


<http://purl.org/dc/terms/issued> rdfs:comment "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty." ;
                                  rdfs:label "Date Issued" ;
                                  <http://www.w3.org/ns/prov#definition> "Date of formal issuance of the resource." .


:Artifact rdfs:comment "A source-grounded, paper-local mention of a scholarly object, method, dataset, metric, task, term, or other noun-phrase referent. Artifacts preserve the original textual expression of concepts within a publication and may be aligned to canonical Concepts across papers." ;
          rdfs:label "artifact" .


:Cause rdfs:comment "A situation that, by means other than motivating a violational or non-violational action caused the situation presented in the artifact." ;
       rdfs:label "cause" ;
       rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Circumstance rdfs:comment "The proposition providing the situation presents the framework for interpreting the artifact." ;
              rdfs:label "circumstance" ;
              rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Concept rdfs:comment "A canonical scholarly concept that provides a cross-publication identity for recurring paper-local Artifact mentions. Concepts abstract over source-specific phrasings while preserving links to the Artifacts through which they are expressed in individual publications" ;
         rdfs:label "concept" .


:Condition rdfs:comment "A realization of the situation presented in the proposition enables the realization of the situation presented in the artifact." ;
           rdfs:label "condition" ;
           rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Descriptor rdfs:comment "A Proposition that contextualizes, qualifies, characterizes, or elaborates an Artifact or another Proposition rather than advancing the publication's main research argument. Descriptors preserve local explanatory, evaluative, definitional, and conditional details that give scholarly concepts and statements their paper-specific meaning." ;
            rdfs:label "descriptor" ;
            rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf"^^xsd:anyURI .


:Elaboration rdfs:comment "Additional details about the situation or some element of subject matter related to the artifact." ;
             rdfs:label "elaboration" ;
             rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Evaluation rdfs:comment "a proposition related the situation in the artifact to degree of context's positive regards toward the situation presented in the artifact." ;
            rdfs:label "evaluation" ;
            rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:HyponymOf rdfs:comment """B is a hyponym of A, B is a  type of A. 

E.g.  TUIT is a software library  NLP applications such as machine translation and language generation""" ;
           rdfs:label "hyponym of" ;
           rdfs:seeAlso "http://arxiv.org/abs/1808.09602" .


:Interpretation rdfs:comment "a proposition relates the situation presented in the artifact to a framework of ideas not involved in the artifact itself." ;
                rdfs:label "interpretation" ;
                rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Material rdfs:comment "Data, datasets, resources, Corpus, Knowledge base. - e.g. image data, speech data, stereo images, bilingual dictionary, paraphrased questions, CoNLL, Panntreebank, WordNet, Wikipedia, etc." ;
          rdfs:label "material" ;
          rdfs:seeAlso "http://arxiv.org/abs/1808.09602" .


:Method rdfs:comment "Methods , models, systems to use, or tools, components of a system, frameworks. - e.g. language model, CORENLP, POS parser, kernel method, etc." ;
        rdfs:label "method" ;
        rdfs:seeAlso "http://arxiv.org/abs/1808.09602" .


:Metric rdfs:comment "Metrics, measures, or entities that can express quality of a system/method. - e.g. F1, BLEU, Precision, Recall, ROC curve, mean reciprocal rank, mean-squared error, robustness, time complexity, etc." ;
        rdfs:label "metric" ;
        rdfs:seeAlso "http://arxiv.org/abs/1808.09602" .


:Proposition rdfs:comment "A source-grounded representation of the meaning expressed by a finite clause in a publication. Propositions preserve what the author asserts, proposes, explains, evaluates, qualifies, or otherwise communicates, and serve as first-class nodes for modeling scholarly discourse and relations that cannot be reduced to entity-to-entity triples." ;
             rdfs:label "proposition" .


:Purpose rdfs:comment "A situation to be realized through the activity in the artifact." ;
         rdfs:label "purpose" ;
         rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Restatement rdfs:comment "a proposition restates the artifact, where the proposition and the artifact are of comparable bulk." ;
             rdfs:label "restatement" ;
             rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Result rdfs:comment "A Proposition presets a situation that could ahve been caused by the situation presented in the artifact." ;
        rdfs:label "result" ;
        rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Solutionhood rdfs:comment "The proposition representing the situation that solves by the artifact." ;
              rdfs:label "solutionhood" ;
              rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Summary rdfs:comment "A restatement of the content of the artifact, that is shorter in bulk." ;
         rdfs:label "summary" ;
         rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:Task rdfs:comment "Applications, problems to solve, systems to construct. - e.g. information extraction, machine reading system, image segmentation, etc." ;
      rdfs:label "task" ;
      rdfs:seeAlso "http://arxiv.org/abs/1808.09602" .


:Term rdfs:comment "General terms or pronouns that may refer to a entity but are not themselves informative, often used as connection words." ;
      rdfs:label "term" ;
      rdfs:seeAlso "http://arxiv.org/abs/1808.09602" .


:causes rdfs:comment "the situation presented in the proposition as a cause for the volitional or non-violation action presented in the artifact" ;
        rdfs:label "causes" ;
        rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:concede rdfs:comment "Relates one Proposition to another Proposition when the source acknowledges a limitation, exception, counterpoint, or opposing consideration while leaving the target proposition still relevant or defensible. This predicate is derived from the RST Concession relation." ;
         rdfs:label "concede" ;
         rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:condition rdfs:comment "recognizes how the realization of the situation presented in artifact depends on the realization of the situation presented in the proposition." ;
           rdfs:label "condition" ;
           rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:contextualizes rdfs:comment "the proposition provides the framework for interpreting the reference artifact." ;
                rdfs:label "contextualizes" ;
                rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:contrast rdfs:comment "Relates one Proposition to another Proposition that it contrasts with, opposes, or presents as an alternative perspective. This predicate is derived from the RST Antithesis relation." ;
          rdfs:label "contrast" ;
          rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:elaborates rdfs:comment """The proposition presents additiona detail about the situation or some element of subject mattern which is presentes in the artifact or inferentially accessible in N in one or more of the way listed below;
set: member
abstract : instance 
whole : part
process : step
object : attribute
generalization : specific""" ;
            rdfs:label "elaborates" ;
            rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:enables rdfs:comment "potential ability to perform the action presented in artifact increases" ;
         rdfs:label "enables" ;
         rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:evaluates rdfs:comment "situation presented in the proposition assess the sutiation presented in the artifact and recognizes the value it assigns." ;
           rdfs:label "evaluates" ;
           rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:evidence rdfs:label "evidence" ;
          rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:forces rdfs:comment "A qualifier that expresses as degree of force concerning a claim of an argument." ;
        rdfs:isDefinedBy "http://purl.org/spar/amo/forces" ;
        rdfs:label "forces" .


:interprets rdfs:comment "the situation presented in the artifact to a framework of ideas not involved in the knowledge presented in the artifact itself." ;
            rdfs:label "interprets" ;
            rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:justify rdfs:comment "Relates one Proposition to another Proposition when the source provides a reason, explanation, or argumentative basis that makes the target acceptable or warranted. This predicate is derived from the RST Justify relation." ;
         rdfs:label "justify" ;
         rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:leadsTo rdfs:comment "A warrant that points to a claim from the related evidence within an argument." ;
         rdfs:isDefinedBy "http://purl.org/spar/amo/leadsTo" ;
         rdfs:label "leads to" .


:mentions rdfs:comment "Relates a Proposition to an Artifact that is explicitly mentioned in the Proposition's source text, without asserting a more specific semantic role between them." ;
          rdfs:label "mentions" ;
          rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:motivates rdfs:comment "desire to perform action presented in the artifact is increased" ;
           rdfs:label "motivates" ;
           rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:proves rdfs:comment "An evidence that founds a claim of an argument." ;
        rdfs:isDefinedBy "http://purl.org/spar/amo/proves" ;
        rdfs:label "proves" .


:purposes rdfs:comment "the activity in the artifact is initiated in order to realize the proposition." ;
          rdfs:label "purposes" ;
          rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:responsesTo rdfs:comment "Relates a Proposition to another Proposition that it addresses as a motivating problem, question, need, or proposed response. This predicate is used both when an Idea responds to an Issue and when an Approach responds to an Issue by operationalizing a way to address it." ;
             rdfs:label "response to" ;
             rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:restates rdfs:comment "a proposition as a restatement of the artifact." ;
          rdfs:label "restates" ;
          rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:result rdfs:comment "recognizes that the situation presented in the artifact, could be a cuase for the action or situation presented in the proposition." ;
        rdfs:label "result" ;
        rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:solves rdfs:comment "The artifact is a solution to the problem stated in the proposition." ;
        rdfs:label "solves" ;
        rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:summarizes rdfs:comment "a proposition as a shorter restatement of the artifact." ;
            rdfs:label "summarizes" ;
            rdfs:seeAlso "https://www.sfu.ca/rst/05bibliographies/bibs/ISI_RS_87_190.pdf" .


:supports rdfs:comment "An evidence that supports a warrant of an argument." ;
          rdfs:isDefinedBy "http://purl.org/spar/amo/supports" ;
          rdfs:label "supports" .


:usedFor rdfs:comment """B is used for A, B models A, A is  trained on B, B exploits A, A is based on B. 

E.g.  The TISPER system has been designed to enable many text applications.""" ;
         rdfs:label "used for" ;
         rdfs:seeAlso "http://arxiv.org/abs/1808.09602"^^xsd:anyURI .


